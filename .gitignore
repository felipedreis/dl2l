# Add any directories, files, or patterns you don't want to be tracked by version control
*.class
target/
*.iml
*.jar
.idea
*.aux
*.log
*.pyc
.DS_Store
__pycache__/

# maven-shade-plugin writes this at the project root (not under target/) on every `mvn package`.
dependency-reduced-pom.xml

# Training data, experiment outputs, and model checkpoints live on HuggingFace,
# not in git. Only the small deployed TorchScript models (src/main/resources/models/)
# stay in the repo since they are needed to build the JAR.
#
# `ml/data/` alone only matches a literal directory named exactly "data" - every real
# experiment's output actually lands at ml/data_<name>/ (e.g. ml/data_ci_regression_benchmark/,
# created locally by `ansible-playbook ... -e experiment=ci_regression_benchmark`), which
# needs the separate glob below to actually be excluded. ml/data_p8/ is a deliberately
# committed exception (a small reference JEPA training dataset), not evidence this pattern
# was meant to match it.
data/
ml/data/
ml/data_*/
ml/checkpoints/
# Ansible per-run scratch state (rendered docker-compose.yml, etc.)
ansible/.run/

# Heap dumps / GC logs (see scripts/run-dl2l.sh, docs/plans/issue-77-bdactor-oom-fix.md) -
# local diagnostic scratch, never committed.
heapdumps/*
!heapdumps/.gitkeep

# Local secrets/PII — never commit (e.g. CCAD_USERNAME, a CPF)
.env.local
.env.*.local
.env

# Ignore raw Java/IDE project files
.classpath
.project
.settings/
.claude/
