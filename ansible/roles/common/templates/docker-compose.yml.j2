# {{ ansible_managed | default("Rendered by ansible/roles/common — do not edit by hand.") }}
# Experiment: {{ experiment_cfg.name }}   Env: {{ dl2l_env }}
#
# SIMULATION and DL2L_RAW_DATA_DIR are deliberately left as compose-level
# ${VAR} env-var substitutions (not Jinja) so ONE rendered file is reused
# across every condition/trial in the matrix — the trial runner exports a
# different value per `docker compose` invocation instead of re-rendering.
# DL2L_RAW_DATA_DIR is where dl2l-holder writes its raw-table Parquet dump at
# trial shutdown (see PersistenceExtension, docs/plans/parquet-write-path.md)
# — replaces the old dl2l-db Postgres service entirely.
version: "3.1"

services:
  dl2l-manager:
    image: "{{ dl2l_image }}"
    environment:
      ROLE: "manager,idProvider"
      SIMULATION: "${SIMULATION:?SIMULATION must be exported before running docker compose}"
      HOST: "dl2l-manager"
      PORT: 2551
    networks:
      - dl2l-network
    healthcheck:
      test: ["CMD", "nc", "-z", "dl2l-manager", "2551"]
      interval: 10s
      timeout: 5s
      retries: 5
    volumes:
      - type: bind
        source: "{{ dl2l_config_dir }}/docker-config.conf"
        target: /config/docker-config.conf
        read_only: true

{% if holder_combines_detector | default(false) %}
  dl2l-holder:
    image: "{{ dl2l_image }}"
    depends_on:
      dl2l-manager:
        condition: service_healthy
    environment:
      ROLE: "collisionDetector,holder"
      SIMULATION: "${SIMULATION:?SIMULATION must be exported before running docker compose}"
      HOST: "dl2l-holder"
      PORT: "2551"
      # See scripts/run-dl2l.sh and docs/plans/arrow-ipc-write-path.md, W5.
      JAVA_XMX: "${DL2L_JAVA_XMX:-2g}"
      TARGET_CYCLE_HZ: "${TARGET_CYCLE_HZ:-30}"
    networks:
      - dl2l-network
{% if publish_ui | default(false) %}
    ports:
      - "8080:8080"
{% endif %}
    volumes:
      - type: bind
        source: "{{ dl2l_config_dir }}/docker-config.conf"
        target: /config/docker-config.conf
        read_only: true
      - type: bind
        source: "${DL2L_RAW_DATA_DIR:?DL2L_RAW_DATA_DIR must be exported before running docker compose}"
        target: /dl2l/data
{% else %}
  dl2l-detector:
    image: "{{ dl2l_image }}"
    depends_on:
      dl2l-manager:
        condition: service_healthy
    environment:
      ROLE: "collisionDetector"
      SIMULATION: "${SIMULATION:?SIMULATION must be exported before running docker compose}"
      HOST: "dl2l-detector"
      PORT: 2551
    networks:
      - dl2l-network
    volumes:
      - type: bind
        source: "{{ dl2l_config_dir }}/docker-config.conf"
        target: /config/docker-config.conf
        read_only: true

  dl2l-holder:
    image: "{{ dl2l_image }}"
    depends_on:
      dl2l-manager:
        condition: service_healthy
      dl2l-detector:
        condition: service_started
    environment:
      ROLE: "holder"
      SIMULATION: "${SIMULATION:?SIMULATION must be exported before running docker compose}"
      HOST: "dl2l-holder"
      PORT: "2551"
      # See scripts/run-dl2l.sh and docs/plans/arrow-ipc-write-path.md, W5.
      JAVA_XMX: "${DL2L_JAVA_XMX:-2g}"
      TARGET_CYCLE_HZ: "${TARGET_CYCLE_HZ:-30}"
    networks:
      - dl2l-network
{% if publish_ui | default(false) %}
    ports:
      - "8080:8080"
{% endif %}
    volumes:
      - type: bind
        source: "{{ dl2l_config_dir }}/docker-config.conf"
        target: /config/docker-config.conf
        read_only: true
      - type: bind
        source: "${DL2L_RAW_DATA_DIR:?DL2L_RAW_DATA_DIR must be exported before running docker compose}"
        target: /dl2l/data
{% endif %}

networks:
  dl2l-network:
    driver: bridge
